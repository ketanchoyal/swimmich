      "extractionState": "stale",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos Immich"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich-Fotos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
