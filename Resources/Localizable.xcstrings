    },
    "Pick at least 1 photo. Its date sets the memory's year.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez au moins 1 photo. Sa date détermine l'année du souvenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens 1 Foto aus. Sein Datum legt das Jahr der Erinnerung fest."
          }
