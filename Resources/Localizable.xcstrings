    "Immich could not reach your server. Check the app can open it.": {
      "extractionState": "stale",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich n'a pas pu joindre votre serveur. Vérifiez que l'app peut l'ouvrir."
          }
        },
        "de": {
          "stringUnit": {
