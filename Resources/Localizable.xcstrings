        }
      }
    },
    "The suggested copies are kept. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorgeschlagenen Kopien werden behalten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan las copias sugeridas. Esta acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie consigliate vengono conservate. L'operazione non può essere annullata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies suggérées sont conservées. Cette action est irréversible."
          }
        }
      }
    },
    "Their photos can appear alongside yours in the timeline. The switch decides that per partner.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Fotos können zusammen mit deinen in der Zeitleiste erscheinen. Der Schalter entscheidet das pro Partner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus fotos pueden aparecer junto a las tuyas en la cronología. El interruptor lo decide para cada socio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le loro foto possono apparire insieme alle tue nella cronologia. L'interruttore lo decide per ogni partner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs photos peuvent apparaître à côté des vôtres dans la timeline. L'interrupteur le définit pour chaque partenaire."
          }
        }
      }
    },
    "They lose access to your library. Your photos stay on the server, and your own timeline is unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verlieren den Zugriff auf deine Mediathek. Deine Fotos bleiben auf dem Server, und deine eigene Zeitleiste bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderán el acceso a tu biblioteca. Tus fotos permanecen en el servidor y tu cronología no se ve afectada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderanno l'accesso alla tua libreria. Le tue foto restano sul server e la tua cronologia non cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils perdent l'accès à votre photothèque. Vos photos restent sur le serveur et votre propre timeline n'est pas affectée."
          }
        }
      }
    },
    "They will no longer be able to view or edit this album.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne pourra plus voir ni modifier cet album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person kann das Album dann nicht mehr ansehen oder bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no podrá ver ni editar este álbum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrà più vedere o modificare questo album."
          }
        }
      }
    },
    "This asset will be permanently deleted. Action cannot be undone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément sera définitivement supprimé. Action irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt wird endgültig gelöscht. Die Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
