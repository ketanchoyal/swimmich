          "stringUnit": {
            "state": "translated",
            "value": "Scegli almeno 1 foto. La sua data imposta l'anno del ricordo."
          }
        }
      }
    },
    "Pick at least 1 photo. The stack's current cover stays its cover.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez au moins 1 photo. La couverture actuelle de la pile reste sa couverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens 1 Foto aus. Das aktuelle Titelbild des Stapels bleibt sein Titelbild."
