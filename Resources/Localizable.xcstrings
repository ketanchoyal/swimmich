          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Roadtrip wurde deiner Mediathek hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El road trip se añadió a tu biblioteca de fotos."
